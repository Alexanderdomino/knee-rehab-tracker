rules_version = '2';

// Single-user knee tracker. Each signed-in user may only read and write their
// own data under users/{uid}/**. Writes are validated for shape and ranges.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNum(v) {
      return v is int || v is float;
    }

    function inRange(v, lo, hi) {
      return isNum(v) && v >= lo && v <= hi;
    }

    function isPain(v) {
      return inRange(v, 0, 10);
    }

    function optionalPain(data, key) {
      return !(key in data) || data[key] == null || isPain(data[key]);
    }

    function isDateString(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // users/{uid}/days/{YYYY-MM-DD}: one overall pain score per day.
    function validDay(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'pain', 'updatedAt'])
        && d.date == date
        && isDateString(date)
        && isPain(d.pain);
    }

    // users/{uid}/entries/{id}: one activity session.
    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasAll(['date', 'activityTypeId', 'activityName', 'kind', 'swelling'])
        && d.keys().hasOnly([
          'date', 'activityTypeId', 'activityName', 'kind', 'durationMin', 'distanceKm',
          'exercises', 'rpe', 'painDuring', 'painNextMorning', 'swelling', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isDateString(d.date)
        && d.activityTypeId is string && d.activityTypeId.size() > 0 && d.activityTypeId.size() <= 64
        && d.activityName is string && d.activityName.size() <= 100
        && d.kind in ['strength', 'cardio']
        // Cardio sessions need a duration (their load); strength load comes from exercises.
        && (d.kind == 'strength' || inRange(d.get('durationMin', null), 0, 1440))
        && (!('durationMin' in d) || d.durationMin == null || inRange(d.durationMin, 0, 1440))
        // RPE is no longer collected; entries logged before may still carry it.
        && (!('rpe' in d) || d.rpe == null || inRange(d.rpe, 1, 10))
        && optionalPain(d, 'painDuring')
        && optionalPain(d, 'painNextMorning')
        && d.swelling in ['none', 'mild', 'moderate']
        && (!('distanceKm' in d) || d.distanceKm == null || inRange(d.distanceKm, 0, 1000))
        && (!('exercises' in d) || (d.exercises is list && d.exercises.size() <= 50))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000));
    }

    // users/{uid}/settings/{doc}: thresholds and activity types.
    function validSettings() {
      let d = request.resource.data;
      return (!('greenMax' in d) || inRange(d.greenMax, 0, 10))
        && (!('amberMax' in d) || inRange(d.amberMax, 0, 10))
        && (!('painThreshold' in d) || isPain(d.painThreshold))
        && (!('greenDaysRequired' in d) || inRange(d.greenDaysRequired, 1, 60))
        && (!('maxWeeklyIncreasePct' in d) || inRange(d.maxWeeklyIncreasePct, 0, 100))
        && (!('acwrUpper' in d) || inRange(d.acwrUpper, 0, 5))
        && (!('acwrLower' in d) || inRange(d.acwrLower, 0, 5))
        && (!('activityTypes' in d) || (d.activityTypes is list && d.activityTypes.size() <= 50));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDay(date);
      }

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry();
      }

      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSettings();
      }
    }

    // Everything else is denied by default.
  }
}
